{
  "entities": {
    "Reservation": {
      "title": "Reservation",
      "description": "A hostel booking reservation record for Moshi Urban Hostel",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking identifier (e.g. MU-1)",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "guestName": {
          "type": "string",
          "description": "Full name of the guest",
          "maxLength": 150
        },
        "guestId": {
          "type": "string",
          "description": "Guest tracking ID (e.g. GS-0001)",
          "maxLength": 64
        },
        "email": {
          "type": "string",
          "description": "Guest email address",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "description": "Guest contact phone or WhatsApp number",
          "maxLength": 50
        },
        "room": {
          "type": "string",
          "description": "Assigned room name",
          "maxLength": 100
        },
        "bedCode": {
          "type": "string",
          "description": "Assigned bed code (e.g. M-S1, N-B1L, B-B1L, S-S1)",
          "maxLength": 30
        },
        "unitId": {
          "type": "string",
          "description": "Unit or bed unit ID",
          "maxLength": 30
        },
        "bedsCount": {
          "type": "number",
          "description": "Number of beds booked"
        },
        "checkIn": {
          "type": "string",
          "description": "Check-in date (YYYY-MM-DD)",
          "maxLength": 20
        },
        "checkOut": {
          "type": "string",
          "description": "Check-out date (YYYY-MM-DD)",
          "maxLength": 20
        },
        "nights": {
          "type": "number",
          "description": "Duration of stay in nights"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total stay price"
        },
        "paidAmount": {
          "type": "number",
          "description": "Amount deposited or paid"
        },
        "balanceDue": {
          "type": "number",
          "description": "Remaining unpaid balance"
        },
        "status": {
          "type": "string",
          "description": "Reservation status",
          "enum": ["Confirmed", "Checked-in", "Checked-out", "Tentative", "No-show", "Cancelled", "Refunded"],
          "maxLength": 30
        },
        "currency": {
          "type": "string",
          "description": "Booking currency",
          "enum": ["USD", "TZS", "EUR", "GBP"],
          "maxLength": 10
        },
        "platform": {
          "type": "string",
          "description": "Channel or platform of reservation",
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "description": "Special requests or guest notes",
          "maxLength": 1000
        },
        "loyalty": {
          "type": "string",
          "description": "Guest loyalty status",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO or server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp ISO or server timestamp"
        }
      },
      "required": ["id", "guestName", "room", "bedCode", "checkIn", "checkOut", "status"]
    },
    "Guest": {
      "title": "Guest",
      "description": "Guest contact and stay history record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Guest ID (e.g. GS-0001)",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Guest full name",
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "description": "Guest email address",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "description": "Phone number",
          "maxLength": 50
        },
        "totalStays": {
          "type": "number",
          "description": "Total number of completed stays"
        },
        "loyalty": {
          "type": "string",
          "description": "Loyalty status",
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "description": "Staff notes about guest",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp created"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp updated"
        }
      },
      "required": ["id", "name"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Individual payment or refund transaction",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique payment identifier",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "reservationId": {
          "type": "string",
          "description": "Associated reservation ID",
          "maxLength": 64
        },
        "guestId": {
          "type": "string",
          "description": "Guest identifier",
          "maxLength": 64
        },
        "amount": {
          "type": "number",
          "description": "Transaction amount"
        },
        "currency": {
          "type": "string",
          "description": "Transaction currency",
          "enum": ["USD", "TZS", "EUR", "GBP"],
          "maxLength": 10
        },
        "type": {
          "type": "string",
          "description": "Payment type",
          "enum": ["deposit", "balance", "full", "refund", "fee"],
          "maxLength": 20
        },
        "method": {
          "type": "string",
          "description": "Payment method (Cash, Card, M-Pesa, Bank, BookingPlatform)",
          "maxLength": 40
        },
        "recordedBy": {
          "type": "string",
          "description": "Email of employee recording payment",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "description": "Payment notes or reference code",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Payment timestamp"
        }
      },
      "required": ["id", "reservationId", "amount", "currency", "type", "recordedBy"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Staff or admin user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Staff email address",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "Staff display name",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "User role",
          "enum": ["admin", "staff", "manager"],
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "Created at timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Updated at timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Hostel PMS user account role and permissions mapping",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Staff or manager email address",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "description": "Permission role level in PMS",
          "enum": ["admin", "manager", "staff"],
          "maxLength": 30
        },
        "displayName": {
          "type": "string",
          "description": "Staff member full name or title",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "description": "Account status",
          "enum": ["active", "suspended"],
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "Created at timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated at timestamp"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email of admin who created or modified this role"
        }
      },
      "required": ["email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Traceable system change log entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Audit log entry ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "action": {
          "type": "string",
          "description": "Action performed",
          "maxLength": 50
        },
        "targetId": {
          "type": "string",
          "description": "Target reservation or entity ID",
          "maxLength": 64
        },
        "guestName": {
          "type": "string",
          "description": "Guest name if applicable",
          "maxLength": 150
        },
        "user": {
          "type": "string",
          "description": "Staff email who performed action",
          "maxLength": 200
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "diffSummary": {
          "type": "string",
          "description": "Summary of changes",
          "maxLength": 500
        }
      },
      "required": ["id", "action", "user", "timestamp"]
    },
    "BedSchedule": {
      "title": "BedSchedule",
      "description": "Atomic bed date allocations tracking schedule for double-booking prevention",
      "type": "object",
      "properties": {
        "bedCode": {
          "type": "string",
          "description": "Bed identifier (e.g. N-B1L, B-ALL)",
          "maxLength": 30
        },
        "room": {
          "type": "string",
          "description": "Room name",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp updated"
        }
      },
      "required": ["bedCode", "room"]
    },
    "BookingCounter": {
      "title": "BookingCounter",
      "description": "Monotonic counter for generating collision-free booking IDs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Counter name",
          "maxLength": 64
        },
        "lastNumber": {
          "type": "number",
          "description": "Last allocated booking integer index"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp updated"
        }
      },
      "required": ["id", "lastNumber"]
    }
  },
  "firestore": {
    "/reservations/{reservationId}": {
      "schema": {
        "$ref": "#/entities/Reservation"
      },
      "description": "Collection of hostel reservation records"
    },
    "/guests/{guestId}": {
      "schema": {
        "$ref": "#/entities/Guest"
      },
      "description": "Collection of guest records"
    },
    "/payments/{paymentId}": {
      "schema": {
        "$ref": "#/entities/Payment"
      },
      "description": "Collection of financial payment and refund entries"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Hostel staff and manager user profiles"
    },
    "/user_roles/{email}": {
      "schema": {
        "$ref": "#/entities/UserRole"
      },
      "description": "Collection of assigned user roles and permission states"
    },
    "/audit_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/AuditLog"
      },
      "description": "Collection of traceable audit trail logs"
    },
    "/bed_schedules/{bedCode}": {
      "schema": {
        "$ref": "#/entities/BedSchedule"
      },
      "description": "Authoritative bed schedules for atomic transaction concurrency protection"
    },
    "/counters/{counterId}": {
      "schema": {
        "$ref": "#/entities/BookingCounter"
      },
      "description": "Monotonic counter documents for unique IDs"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/connection {
      allow read: if true;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['id', 'guestName', 'room', 'bedCode', 'checkIn', 'checkOut', 'status'])
        && data.id is string && data.id.size() <= 64
        && data.guestName is string && data.guestName.size() > 0 && data.guestName.size() <= 150
        && data.room is string && data.room.size() <= 100
        && data.bedCode is string && data.bedCode.size() <= 30
        && data.checkIn is string && data.checkIn.size() <= 20
        && data.checkOut is string && data.checkOut.size() <= 20
        && data.status is string && data.status.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('totalAmount' in data) || data.totalAmount is number)
        && (!('paidAmount' in data) || data.paidAmount is number)
        && (!('balanceDue' in data) || data.balanceDue is number)
        && (!('nights' in data) || data.nights is number);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('role' in data) || (data.role is string && data.role.size() <= 30));
    }

    // Reservations Collection
    match /reservations/{reservationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(reservationId)
        && isValidReservation(incoming());
      allow update: if isSignedIn()
        && isValidId(reservationId)
        && isValidReservation(incoming());
      allow delete: if isSignedIn()
        && isValidId(reservationId);
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (!('role' in incoming()) || incoming().role != 'admin');
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;
    }
  }
}

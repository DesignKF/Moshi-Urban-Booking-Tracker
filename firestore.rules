rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/connection {
      allow read: if true;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['id', 'guestName', 'room', 'bedCode', 'checkIn', 'checkOut', 'status'])
        && data.id is string && data.id.size() <= 64
        && data.guestName is string && data.guestName.size() > 0 && data.guestName.size() <= 150
        && data.room is string && data.room.size() <= 100
        && data.bedCode is string && data.bedCode.size() <= 30
        && data.checkIn is string && data.checkIn.size() <= 20
        && data.checkOut is string && data.checkOut.size() <= 20
        && data.status is string && data.status.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('guestId' in data) || (data.guestId is string && data.guestId.size() <= 64))
        && (!('unitId' in data) || (data.unitId is string && data.unitId.size() <= 30))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('platform' in data) || (data.platform is string && data.platform.size() <= 60))
        && (!('loyalty' in data) || (data.loyalty is string && data.loyalty.size() <= 60))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('totalAmount' in data) || data.totalAmount is number)
        && (!('paidAmount' in data) || data.paidAmount is number)
        && (!('balanceDue' in data) || data.balanceDue is number)
        && (!('bedsCount' in data) || data.bedsCount is number)
        && (!('nights' in data) || data.nights is number);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('role' in data) || (data.role is string && data.role.size() <= 30))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidUserRole(data) {
      return data.keys().hasAll(['email', 'role'])
        && data.email is string && data.email.size() <= 200
        && data.role in ['admin', 'manager', 'staff']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('status' in data) || data.status in ['active', 'suspended'])
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    function isHardcodedAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'wolfgodie@gmail.com',
        'gdnjau@gmail.com',
        'designkilifair@gmail.com'
      ];
    }

    function isHardcodedPropertyManager() {
      return isSignedIn() && request.auth.token.email == 'moshiurbanproperty@gmail.com';
    }

    function isDatabaseAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email))
          && get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.role == 'admin'
          && (!('status' in get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data)
              || get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.status != 'suspended'))

      );
    }

    function isAdmin() {
      return isHardcodedAdmin() || isDatabaseAdmin();
    }

    function isPropertyManager() {
      return isHardcodedPropertyManager() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email))
            && get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.role == 'manager'
            && (!('status' in get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data)
                || get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.status != 'suspended'))

        )
      );
    }

    function isPropertyManagerOrAdmin() {
      return isAdmin() || isPropertyManager();
    }

    // Reservations Collection - Publicly viewable hostel bookings & availability, editable only by authorized Admins and Property Managers
    match /reservations/{reservationId} {
      allow get, list: if isPropertyManagerOrAdmin();
      allow create: if isPropertyManagerOrAdmin()
        && isValidId(reservationId)
        && isValidReservation(incoming());
      allow update: if isPropertyManagerOrAdmin()
        && isValidId(reservationId)
        && isValidReservation(incoming());
      allow delete: if isPropertyManagerOrAdmin() && isValidId(reservationId);
    }

    // User Roles Collection - Managed by administrators to grant or revoke app access
    match /user_roles/{email} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidUserRole(incoming());
      allow delete: if isAdmin();
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn()
        && (request.auth.uid == userId || isAdmin())
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (isAdmin()
          || ((!('role' in incoming()) || incoming().role == 'staff')
            && (!exists(/databases/$(database)/documents/users/$(userId))
              || !('role' in existing())
              || incoming().role == existing().role)));
      allow delete: if isAdmin();
    }
  }
}

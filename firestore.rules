rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check endpoint for connection verification
    match /test/connection {
      allow get: if true;
    }

    // Global primitive functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Checks if the user is suspended in the authoritative user_roles collection
    function isSuspended() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.get('status', 'active') == 'suspended';
    }

    // System bootstrap administrators
    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in [
          'designkilifair@gmail.com',
          'wolfgodie@gmail.com',
          'gdnjau@gmail.com'
        ];
    }

    // Checks if user is an approved employee/admin account in user_roles collection
    function isApprovedUser() {
      return isSignedIn()
        && request.auth.token.email != null
        && !isSuspended()
        && (
          (exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email))
            && get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.get('status', 'active') == 'active')
          || (!exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email)) && isBootstrapAdmin())
        );
    }

    // System Administrator: authoritative user_roles takes precedence, fallback to bootstrap list
    function isAdmin() {
      return isApprovedUser()
        && (
          (exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email))
            && get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.role == 'admin')
          || (!exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email))
            && isBootstrapAdmin())
        );
    }

    // Property Manager: permitted to manage bookings, guests, and payments
    function isPropertyManager() {
      return isApprovedUser()
        && (
          isAdmin()
          || (exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email))
            && get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.role == 'manager')
          || (!exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email))
            && request.auth.token.email == 'moshiurbanproperty@gmail.com')
        );
    }

    // Staff member: verified active staff member in user_roles
    function isStaff() {
      return isApprovedUser();
    }

    // Entity Validation: Reservation
    function isValidReservation(data) {
      return data.keys().hasAll(['id', 'guestName', 'room', 'bedCode', 'checkIn', 'checkOut', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.guestName is string && data.guestName.size() > 0 && data.guestName.size() <= 150
        && data.room is string && data.room.size() > 0 && data.room.size() <= 100
        && data.bedCode is string && data.bedCode.size() > 0 && data.bedCode.size() <= 30
        && data.checkIn is string && data.checkIn.size() <= 20
        && data.checkOut is string && data.checkOut.size() <= 20
        && data.checkIn < data.checkOut
        && data.status is string && data.status.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('guestId' in data) || (data.guestId is string && data.guestId.size() <= 64))
        && (!('unitId' in data) || (data.unitId is string && data.unitId.size() <= 30))
        && (!('currency' in data) || (data.currency is string && data.currency in ['USD', 'TZS', 'EUR', 'GBP']))
        && (!('platform' in data) || (data.platform is string && data.platform.size() <= 60))
        && (!('loyalty' in data) || (data.loyalty is string && data.loyalty.size() <= 60))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('totalAmount' in data) || (data.totalAmount is number && data.totalAmount >= 0))
        && (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0))
        && (!('balanceDue' in data) || data.balanceDue is number)
        && (!('bedsCount' in data) || (data.bedsCount is number && data.bedsCount > 0))
        && (!('nights' in data) || (data.nights is number && data.nights > 0));
    }

    // Entity Validation: Guest
    function isValidGuest(data) {
      return data.keys().hasAll(['id', 'name'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('totalStays' in data) || data.totalStays is number)
        && (!('loyalty' in data) || (data.loyalty is string && data.loyalty.size() <= 60))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Entity Validation: Payment
    function isValidPayment(data) {
      return data.keys().hasAll(['id', 'reservationId', 'amount', 'currency', 'type', 'recordedBy'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.reservationId is string && data.reservationId.size() > 0 && data.reservationId.size() <= 64
        && data.amount is number && data.amount > 0
        && data.currency in ['USD', 'TZS', 'EUR', 'GBP']
        && data.type in ['deposit', 'balance', 'full', 'refund', 'fee']
        && data.recordedBy is string && data.recordedBy.size() <= 200
        && (!('guestId' in data) || (data.guestId is string && data.guestId.size() <= 64))
        && (!('method' in data) || (data.method is string && data.method.size() <= 40))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Entity Validation: UserRole
    function isValidUserRole(data) {
      return data.keys().hasAll(['email', 'role'])
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.role in ['admin', 'manager', 'staff']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('status' in data) || data.status in ['active', 'suspended'])
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    // Entity Validation: UserProfile (prevents self-escalation)
    // Entity Validation: UserProfile (prevents self-escalation)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('role' in data) || (data.role == 'viewer' || isAdmin()))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Entity Validation: AuditLog
    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'action', 'user', 'timestamp'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.action is string && data.action.size() <= 50
        && data.user is string && data.user.size() <= 200
        && data.timestamp is string && data.timestamp.size() <= 50
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 64))
        && (!('guestName' in data) || (data.guestName is string && data.guestName.size() <= 150))
        && (!('diffSummary' in data) || (data.diffSummary is string && data.diffSummary.size() <= 500));
    }

    // 1. Reservations Collection
    // Read: Authenticated approved staff and managers only (NO public reads!)
    // Create & Update: Approved staff, managers, and admins with full schema validation
    // Delete: Admins only
    match /reservations/{reservationId} {
      allow get, list: if isStaff();
      allow create: if isStaff()
        && isValidId(reservationId)
        && isValidReservation(incoming());
      allow update: if isStaff()
        && isValidId(reservationId)
        && isValidReservation(incoming())
        && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(reservationId);
    }

    // 2. Guests Collection
    // Read: Authenticated approved staff
    // Create & Update: Approved staff, managers, and admins
    // Delete: Admins only
    match /guests/{guestId} {
      allow get, list: if isStaff();
      allow create: if isStaff()
        && isValidId(guestId)
        && isValidGuest(incoming());
      allow update: if isStaff()
        && isValidId(guestId)
        && isValidGuest(incoming())
        && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(guestId);
    }

    // 3. Payments Collection
    // Read: Authenticated approved staff
    // Create: Approved staff, managers, and admins (idempotent payment records)
    // Update: Admins only (financial adjustments)
    // Delete: Admins only
    match /payments/{paymentId} {
      allow get, list: if isStaff();
      allow create: if isStaff()
        && isValidId(paymentId)
        && isValidPayment(incoming());
      allow update: if isAdmin()
        && isValidId(paymentId)
        && isValidPayment(incoming())
        && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(paymentId);
    }

    // 4. User Roles Collection: RBAC Access Control
    // Read: Own role by signed-in user, list by approved staff only
    // Manage: Administrator only
    match /user_roles/{email} {
      allow get: if isSignedIn() && (request.auth.token.email == email || isApprovedUser());
      allow list: if isApprovedUser();
      allow create, update: if isAdmin() && isValidUserRole(incoming());
      allow delete: if isAdmin();
    }

    // 5. User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn()
        && (request.auth.uid == userId || isAdmin())
        && isValidId(userId)
        && isValidUserProfile(incoming());
      allow delete: if isAdmin();
    }

    // 6. Audit Logs Collection
    match /audit_logs/{logId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if isAdmin();
    }

    // 7. Bed Schedules Collection (atomic concurrency protection)
    match /bed_schedules/{bedCode} {
      allow get, list: if isStaff();
      allow create, update: if isStaff() && isValidId(bedCode);
      allow delete: if isAdmin() && isValidId(bedCode);
    }

    // 8. Counters Collection (unique ID generation)
    match /counters/{counterId} {
      allow get: if isStaff();
      allow create, update: if isStaff() && isValidId(counterId);
      allow delete: if isAdmin() && isValidId(counterId);
    }
  }
}
